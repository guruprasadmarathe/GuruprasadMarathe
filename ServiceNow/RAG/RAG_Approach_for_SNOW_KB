## 🛠️ Example Mini-Pipeline (Python + LangChain)

```python
import requests, html2text
from langchain_text_splitters import RecursiveCharacterTextSplitter
from openai import OpenAI

BASE = "https://yourinstance.service-now.com"
auth = ("api_user", "token")

# Step 1: Extract
resp = requests.get(f"{BASE}/api/now/table/kb_knowledge",
    params={"sysparm_fields":"sys_id,number,short_description,text,sys_updated_on"},
    auth=auth)
articles = resp.json()["result"]

# Step 2: Transform + Chunk
splitter = RecursiveCharacterTextSplitter(chunk_size=800, chunk_overlap=100)
def clean(html): return html2text.HTML2Text().handle(html or "")

docs = []
for art in articles:
    chunks = splitter.split_text(clean(art["text"]))
    for i, c in enumerate(chunks):
        docs.append({
            "id": f"{art['sys_id']}-{i}",
            "text": c,
            "metadata": {"number": art["number"], "sn_id": art["sys_id"]}
        })

# Step 3: Embed (example with OpenAI)
client = OpenAI()
embeddings = [client.embeddings.create(model="text-embedding-3-large", input=d["text"]).data[0].embedding for d in docs]

# Next: upsert to Azure AI Search / Qdrant / Weaviate...
```

